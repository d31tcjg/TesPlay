# Native launch: node --env-file=.env server/index.js
# Compose reads .env for interpolation. Do not commit the filled .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=4174
DATA_DIR=./data
SERVER_NAME=TesPlay
REMOTE_ENABLED=true

# Local first run. For public use set https://media.example.com
# HTTPS automatically enables secure session cookies; use that exact URL to log in.
PUBLIC_URL=http://127.0.0.1:4174
# Set to 1 only when the sole ingress is a trusted local reverse proxy/tunnel.
TRUST_PROXY=0

# Leave empty to receive a random setup token in the server console before owner creation.
SETUP_TOKEN=
# Leave empty to generate data/encryption.key. Keep that file with database backups.
# Optional alternative: exactly 64 hex characters. Back up this value separately.
ENCRYPTION_KEY=

# Compose-only settings. MEDIA_DIR must exist before docker compose up.
APP_HOST_PORT=4174
MEDIA_DIR=./media
DATA_VOLUME_NAME=aperture-data
NODE_IMAGE=node:22-bookworm-slim
# Optional tunnel profile. Paste the existing tunnel connector token here locally.
# No DNS, tunnel, or Cloudflare Access configuration is created by this project.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Native YouTube playback is opt-in. Install yt-dlp with its default extras first.
YOUTUBE_ENABLED=false
YT_DLP_PATH=yt-dlp
# Optional Docker youtube profile pins its resolver dependency.
YT_DLP_VERSION=2026.08.19

# Installation-owned Google web client; add each deployment's OAuth callbacks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use distinct image tags for a parallel staging installation.
APP_IMAGE=tesplay:local
YOUTUBE_IMAGE=tesplay-youtube:local
